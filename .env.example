AGENT_IDENTITY_NAME=AppServiceLearningAgent
A365_SPONSOR_USER_ID=
A365_SPONSOR_DISPLAY_NAME=
A365_SPONSOR_UPN=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Administrative notebook only; never deployed to the running app.
ENTRA_PROVISIONING_CLIENT_ID=
ONBOARDING_SPONSOR_USER_ID=
